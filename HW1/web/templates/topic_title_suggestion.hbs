<p class="topic-title-suggestion-reason">{{reason}}</p>
<table class="topic-title-suggestion-titles">
    <tr>
        <td class="topic-title-suggestion-label">{{t "Current"}}</td>
        <td class="topic-title-suggestion-current">{{current_title}}</td>
    </tr>
    <tr>
        <td class="topic-title-suggestion-label">{{t "Suggested"}}</td>
        <td class="topic-title-suggestion-new">
            <strong>{{suggested_title}}</strong>
        </td>
    </tr>
</table>
<p class="topic-title-suggestion-note">
    <em>{{t
            "Renaming moves every message in this topic. AI suggestions may be wrong."
        }}</em>
</p>